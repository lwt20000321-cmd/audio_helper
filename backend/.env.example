# ── 阿里云百炼（北京地域）──────────────────────────────────
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com
BAILIAN_COMPATIBLE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# ── DeepSeek ─────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── 高德地图（Web 服务类型 Key）──────────────────────────────
AMAP_API_KEY=
AMAP_GEOCODE_URL=https://restapi.amap.com/v3/geocode/geo
AMAP_POI_URL=https://restapi.amap.com/v3/place/around

# ── 模型名称 ──────────────────────────────────────────────
ASR_MODEL=qwen3-asr-flash
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
EXTRACT_MODEL=deepseek-v4-flash
FINALIZE_MODEL=deepseek-v4-flash

# ── 存储与有效期 ──────────────────────────────────────────
STORAGE_DIR=storage
AUDIO_EXPIRE_SECONDS=86400
